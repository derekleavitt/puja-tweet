{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Authorized Google accounts. The single admin (see shared/owner.ts) has full access.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "viewer"
          ],
          "description": "Role in the system"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "lastLogin": {
          "type": "string",
          "description": "ISO timestamp of last login"
        }
      },
      "required": [
        "email",
        "role"
      ]
    },
    "settings": {
      "title": "Bot Settings",
      "description": "Persisted bot configuration and schedule parameters",
      "type": "object",
      "properties": {
        "targetTweetId": {
          "type": "string"
        },
        "replyTargetMode": {
          "type": "string",
          "enum": [
            "original_post",
            "last_comment"
          ],
          "description": "Whether drops reply to original post or last comment made by us"
        },
        "lastPostedTweetId": {
          "type": "string"
        },
        "scheduleTimes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timezone": {
          "type": "string"
        },
        "schedulerEnabled": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "template": {
          "type": "string"
        },
        "themePreference": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        }
      },
      "required": [
        "targetTweetId",
        "scheduleTimes",
        "timezone",
        "schedulerEnabled"
      ]
    },
    "postLogs": {
      "title": "Post Logs",
      "description": "History of dispatched or simulated tweets",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "slotType": {
          "type": "string"
        },
        "targetTweetId": {
          "type": "string"
        },
        "replyToTweetId": {
          "type": "string"
        },
        "color": {
          "type": "object"
        },
        "tweetText": {
          "type": "string"
        },
        "tweetId": {
          "type": "string"
        },
        "tweetUrl": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "contextName": {
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "slotType",
        "targetTweetId",
        "tweetText",
        "status"
      ]
    },
    "contexts": {
      "title": "Tweet Contexts",
      "description": "Configurable tweet targets, schedules, templates and themes for multiple automated campaigns",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "targetTweetId": {
          "type": "string"
        },
        "replyTargetMode": {
          "type": "string",
          "enum": [
            "original_post",
            "last_comment"
          ],
          "description": "Whether to reply to original post or last comment made by us"
        },
        "lastPostedTweetId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "object"
        },
        "template": {
          "type": "string"
        },
        "themePreference": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "targetTweetId",
        "enabled"
      ]
    }
  }
}
