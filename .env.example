# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twitter / X Developer Account Credentials (User Context OAuth 1.0a or OAuth 2.0)
# From https://developer.x.com/en/portal/dashboard (Keys and Tokens tab)
# Ensure your app has "Read and Write" permissions enabled under User authentication settings.
TWITTER_API_KEY="MY_TWITTER_API_KEY"
TWITTER_API_SECRET="MY_TWITTER_API_SECRET"
TWITTER_ACCESS_TOKEN="MY_TWITTER_ACCESS_TOKEN"
TWITTER_ACCESS_TOKEN_SECRET="MY_TWITTER_ACCESS_TOKEN_SECRET"
# Or OAuth 2.0 Bearer Token (if using app or user bearer token with tweet.write scope)
TWITTER_BEARER_TOKEN=""

# Target Tweet ID to reply to (Default: 2103110008212992249)
TARGET_TWEET_ID="2103110008212992249"

# Posting Schedule Configuration
SCHEDULE_TIMES="06:00,18:00"
SCHEDULE_TIMEZONE="MST"


# Runtime
# PORT: HTTP port (Cloud Run / Railway / Fly inject this). Default 3000.
PORT="3000"
# NODE_ENV: "production" serves the built frontend from dist/ (the Dockerfile sets this).
NODE_ENV="production"
# APP_VERSION: optional override for the version reported by GET /api/health (default: package.json).
APP_VERSION=""
# GEMINI_TIMEOUT_MS / X_TIMEOUT_MS: optional upstream request timeouts in milliseconds.
GEMINI_TIMEOUT_MS=""
X_TIMEOUT_MS=""

# SEC-2: Firebase ID-token auth for /api/*
# Firebase project used to verify ID tokens (same project as firebase-applet-config.json).
FIREBASE_PROJECT_ID="hitthehatch"
# Comma-separated admin emails allowed to call the API (empty = nobody is authorized).
AUTHORIZED_EMAILS="the.derek.leavitt@gmail.com"
# firebase-admin credentials: use ADC / GOOGLE_APPLICATION_CREDENTIALS, or inline service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Local development only: skips auth on every /api route (logged loudly at boot).
AUTH_DISABLED="false"
