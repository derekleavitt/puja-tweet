# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twitter / X Developer Account Credentials (User Context OAuth 1.0a or OAuth 2.0)
# From https://developer.x.com/en/portal/dashboard (Keys and Tokens tab)
# Ensure your app has "Read and Write" permissions enabled under User authentication settings.
TWITTER_API_KEY="MY_TWITTER_API_KEY"
TWITTER_API_SECRET="MY_TWITTER_API_SECRET"
TWITTER_ACCESS_TOKEN="MY_TWITTER_ACCESS_TOKEN"
TWITTER_ACCESS_TOKEN_SECRET="MY_TWITTER_ACCESS_TOKEN_SECRET"
# Or OAuth 2.0 Bearer Token (if using app or user bearer token with tweet.write scope)
TWITTER_BEARER_TOKEN=""
# Optional OAuth 2.0 user-context values (env values always take precedence over the UI):
# TWITTER_OAUTH2_CLIENT_ID=""
# TWITTER_OAUTH2_CLIENT_SECRET=""
# TWITTER_OAUTH2_ACCESS_TOKEN=""
# TWITTER_OAUTH2_REFRESH_TOKEN=""

# CREDENTIALS_ENCRYPTION_KEY: 32-byte key (64 hex chars or base64; e.g. `openssl rand -hex 32`).
# Encrypts (AES-256-GCM) X keys entered in the UI, and refreshed OAuth 2.0 tokens, at rest.
# If unset, saving keys from the UI is refused: provide them as env vars above instead.
CREDENTIALS_ENCRYPTION_KEY=""

# Default target Tweet ID for new campaigns (single source of truth; exposed via /api/status)
TARGET_TWEET_ID="2103110008212992249"

# Posting Schedule Configuration
SCHEDULE_TIMES="06:00,18:00"
SCHEDULE_TIMEZONE="America/Denver"


# Runtime
# PORT: HTTP port (Cloud Run / Railway / Fly inject this). Default 3000.
PORT="3000"
# NODE_ENV: "production" serves the built frontend from dist/ (the Dockerfile sets this).
NODE_ENV="production"
# APP_VERSION: optional override for the version reported by GET /api/health (default: package.json).
APP_VERSION=""
# GEMINI_TIMEOUT_MS / X_TIMEOUT_MS: optional upstream request timeouts in milliseconds.
GEMINI_TIMEOUT_MS=""
X_TIMEOUT_MS=""

# REL-2: persistence backend. json (default, local file under DATA_DIR), memory (no persistence),
# or firestore (single source of truth in production; set this on Cloud Run).
STORE="json"
# Firestore database id used when STORE=firestore. Blank = firestoreDatabaseId from
# firebase-applet-config.json (the named AI Studio database). Credentials: ADC on Cloud Run, or
# FIREBASE_SERVICE_ACCOUNT_JSON below.
FIRESTORE_DATABASE_ID=""

# SEC-2: Firebase ID-token auth for /api/*
# Firebase project used to verify ID tokens (same project as firebase-applet-config.json).
FIREBASE_PROJECT_ID="hitthehatch"
# Comma-separated admin emails allowed to call the API (empty = the owner email from shared/owner.ts).
AUTHORIZED_EMAILS=""
# firebase-admin credentials: use ADC / GOOGLE_APPLICATION_CREDENTIALS, or inline service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Local development only: skips auth on every /api route (logged loudly at boot).
AUTH_DISABLED="false"

# PORT-2: optional X handle (without @) used in server error messages; blank = "your account".
X_HANDLE=""

# PORT-2: client (Vite, build-time) overrides. Blank = use firebase-applet-config.json / owner default.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# Comma-separated UI allow-list; blank = the owner email (shared/owner.ts). Keep AUTHORIZED_EMAILS and firestore.rules in sync.
VITE_AUTHORIZED_EMAILS=""

# BUG-7: Gemini tuning (all optional)
# GEMINI_MODEL: primary model; GEMINI_FALLBACK_MODEL: tried next (comma list ok). Blank = built-in defaults
# (gemini-3.8-flash, gemini-3.1-flash-lite, gemini-flash-latest).
GEMINI_MODEL=""
GEMINI_FALLBACK_MODEL=""
# GEMINI_MAX_CALLS_PER_DAY: cap on Gemini API calls per UTC day; blank = unlimited.
GEMINI_MAX_CALLS_PER_DAY=""

# Scheduler safety (REL-5)
# SCHEDULER_TICK_TIMEOUT_MS: watchdog deadline for one scheduler tick (default 120000).
SCHEDULER_TICK_TIMEOUT_MS=""
# MAX_CONSECUTIVE_ERRORS: auto-pause a campaign after this many failed drops in a row (default 5).
MAX_CONSECUTIVE_ERRORS=""

# Serverless / scale-to-zero (Cloud Run + Cloud Scheduler, see docs/gcp-setup.md)
# SCHEDULER_MODE: interval (default, in-process 10 s loop) or external (no loop; Cloud Scheduler POSTs
# /api/cron/tick every minute and every non-GET request flushes state before responding).
SCHEDULER_MODE="interval"
# CRON_SECRET: required by POST /api/cron/tick (header x-cron-secret). Unset = the endpoint answers 503.
CRON_SECRET=""
# MAX_DROPS_PER_TICK: drops one tick may start (default 5); the rest continue on the next tick.
MAX_DROPS_PER_TICK=""
