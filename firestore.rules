rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // State lives in Firestore under `chromabot/` and is read/written only by the server through
    // the admin SDK (which bypasses these rules). Clients get no access to any collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
